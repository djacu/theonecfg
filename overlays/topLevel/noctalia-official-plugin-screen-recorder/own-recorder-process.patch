+-- ── Own capture process ──────────────────────────────────────────────────
+
+local function sendSignal(pid, signal)
+    noctalia.runAsync(`kill -s {signal} {pid} 2>/dev/null || true`)
+end
+
+-- The launched recorder has exited and been reaped: report how it ended and go
+-- idle. Nothing else moves an own capture out of its state, so a recorder still
+-- saving after a stop is never mistaken for a new one.
+local function onCaptureExit(ended, code)
+    log(`gpu-screen-recorder exited with status {code}`)
+    local endedIn = state
+    setState("idle")
+
+    if endedIn == "pending" or endedIn == "replay_pending" then
+        if ended.stopping then
+            log("capture stopped before it started")
+        elseif portalCaptureCancelled() then
+            log("target selection cancelled by user")
+        elseif endedIn == "pending" then
+            logGsrTail("recording failed to start")
+            noctalia.notifyError(noctalia.tr("notify.recording-failed"), noctalia.tr("notify.recording-stopped-early"))
+        else
+            logGsrTail("replay buffer failed to start")
+            noctalia.notifyError(noctalia.tr("notify.replay-failed"), noctalia.tr("notify.recording-stopped-early"))
+        end
+    elseif endedIn == "recording" then
+        if ended.killed then
+            logGsrTail("gpu-screen-recorder did not stop within 3s and was killed")
+            noctalia.notifyError(noctalia.tr("notify.recording-failed"), noctalia.tr("notify.recording-stopped-early"))
+        else
+            if not ended.stopping then
+                log("recording process ended on its own")
+            end
+            notifyRecordingSavedIfPresent(not ended.stopping)
+        end
+    elseif endedIn == "replaying" then
+        if not ended.stopping then
+            log("replay buffer process ended on its own")
+            logGsrTail("replay buffer stopped")
+        end
+        noctalia.notify(noctalia.tr("notify.replay-stopped"))
+    end
+
+    -- A recorder adopted later is not ours; never report this file for it.
+    outputPath = ""
+    updateDisplay()
+end
+
+local function onCaptureLine(id, line)
+    if capture == nil or capture.id ~= id then return end
+
+    local pid = line:match("^pid (%d+)$")
+    if pid ~= nil then
+        capture.pid = tonumber(pid)
+        if capture.stopping then
+            sendSignal(capture.pid, "INT") -- stopped before the pid arrived
+        end
+        return
+    end
+
+    local code = line:match("^exit (%d+)$")
+    if code ~= nil then
+        local ended = capture
+        capture = nil
+        onCaptureExit(ended, tonumber(code))
+    end
+end
+
+local function launchCapture(cmd)
+    captureSeq += 1
+    local id = captureSeq
+    capture = { id = id, pid = nil, stopping = false, killAt = 0, killed = false }
+    if noctalia.runStream(cmd, function(line) onCaptureLine(id, line) end) then
+        return true
+    end
+    capture = nil
+    return false
+end
+
+-- Ask the own recorder to stop; update() kills it if it is still running 3s
+-- later, and onCaptureExit reports the result once it has exited.
+local function stopCapture()
+    if capture.stopping then return end
+    capture.stopping = true
+    capture.killAt = tickCount + STOP_KILL_TICKS
+    if capture.pid ~= nil then
+        sendSignal(capture.pid, "INT")
+    end
+end
+
