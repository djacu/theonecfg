+-- Start the recorder in the background, print "pid N", then "exit N" once it
+-- has exited. The shell reaps it only at `wait`, so the pid cannot be reused
+-- before "exit" is printed. setsid gives the recorder its own process group:
+-- Noctalia kills a stream's whole group when it ends the stream on reload or
+-- exit, which would cut the recording off mid-save. onExit stops it cleanly.
+local function trackedCommand(header, flags)
+    return `{header}\n{buildGsrPrefix()} {flags} &{buildGsrSuffix()} {flags} &\nelse\n  echo "exit 127"\n  exit 0\nfi\necho "pid $!"\nwait $!\necho "exit $?"`
 end
 
